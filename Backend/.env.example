# Payouts are opt-in. Leave disabled until sandbox credentials are configured.
GROUPIA_BICTORYS_PAYOUTS_ENABLED=false
GROUPIA_BICTORYS_PRIVATE_KEY=
GROUPIA_BICTORYS_MERCHANT_SECRET_CODE=

# Existing incoming-payment adapter: required when enabling sandbox payouts.
BICTORYS_ENABLED=false
BICTORYS_API_URL=https://api.test.bictorys.com
BICTORYS_API_KEY=
BICTORYS_WEBHOOK_SECRET=

# Merge these names into your existing environment; this file is not a full application configuration.
# Never commit the actual keys, merchant code or webhook secret.


# Merchant payouts: separate from customer refunds. The production adapter is unavailable in V1.
# Turning this flag on alone cannot enable real disbursements. No credentials are needed while disabled.
GROUPIA_MERCHANT_PAYOUTS_ENABLED=false
