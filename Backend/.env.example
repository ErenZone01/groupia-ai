# Payouts are opt-in. Leave disabled until sandbox credentials are configured.
GROUPIA_BICTORYS_PAYOUTS_ENABLED=false
GROUPIA_BICTORYS_PRIVATE_KEY=
GROUPIA_BICTORYS_MERCHANT_SECRET_CODE=

# Existing incoming-payment adapter: required when enabling sandbox payouts.
BICTORYS_ENABLED=false
BICTORYS_API_URL=https://api.test.bictorys.com
BICTORYS_API_KEY=
BICTORYS_WEBHOOK_SECRET=

# Direct checkout / payment opt-ins for a dedicated sandbox pilot only.
# These switches are independent. Always leave false in production until verified.
GROUPIA_DIRECT_CHECKOUT_ENABLED=false
GROUPIA_DIRECT_PICKUP_LOCATION_REQUIRED=true
GROUPIA_DIRECT_PAYMENT_AUTO_PREPARE_ENABLED=false
GROUPIA_DIRECT_PAYMENT_INITIATION_ENABLED=false

# Merge these names into your existing environment; this file is not a full application configuration.
# Never commit the actual keys, merchant code or webhook secret.


# Merchant payouts: separate from customer refunds. The production adapter is unavailable in V1.
# Turning this flag on alone cannot enable real disbursements. No credentials are needed while disabled.
GROUPIA_MERCHANT_PAYOUTS_ENABLED=false

# Subscription-only revenue V1: no per-order Groupia fee by default.
# Leave false even if the old GROUPIA_PLATFORM_FEE_XOF=300 is still in an existing .env.
# Old order snapshots retain their original fee; only NEW orders use this policy.
GROUPIA_TRANSACTION_FEES_ENABLED=false
GROUPIA_PLATFORM_FEE_XOF=300

# Subscription billing is opt-in for each monthly invoice; there is no recurring charge.
# Enforce access only after validating trials, renewals and Bictorys in local sandbox.
GROUPIA_SUBSCRIPTIONS_ENABLED=true
GROUPIA_SUBSCRIPTION_ENFORCEMENT_ENABLED=false
GROUPIA_SUBSCRIPTION_TRIAL_MONTHS=1
GROUPIA_SUBSCRIPTION_MONTHLY_XOF=10000

# Bictorys subscription setup remains disabled until its payment evidence contract is verified.
GROUPIA_BICTORYS_SUBSCRIPTIONS_ENABLED=false
GROUPIA_BICTORYS_SUBSCRIPTION_PLAN_ID=

# Hardening: merge into a local environment or your deployment secret store.
# Never commit filled values. Preserve the existing DB password on initialized volumes.
POSTGRES_PASSWORD=
GROUPIA_JWT_SECRET_BASE64=
GROUPIA_AUTH_RATE_LIMIT_KEY_BASE64=
GROUPIA_MONITORING_TOKEN=
GROUPIA_CUSTOMER_MAGIC_KEY_BASE64=
GROUPIA_CUSTOMER_OTP_PEPPER_BASE64=
GROUPIA_WHATSAPP_ACCESS_TOKEN=
# Production deployment additionally requires SPRING_PROFILES_ACTIVE=prod and real datasource settings.

# Independent Base64-encoded random key (at least 32 bytes), never reuse another secret.
GROUPIA_REFRESH_TOKEN_PEPPER_BASE64=
# Exact browser origin; update when the Cloudflare Quick Tunnel URL changes.
GROUPIA_AUTH_ALLOWED_ORIGINS=
# false only for explicit HTTP loopback development, never prod or Cloudflare HTTPS.
GROUPIA_AUTH_COOKIE_SECURE=true

# Free local media: enable and set storage type to filesystem; no cloud account required.
GROUPIA_MEDIA_ENABLED=false
GROUPIA_MEDIA_STORAGE_TYPE=
GROUPIA_MEDIA_LOCAL_ROOT=.groupia-media
GROUPIA_MEDIA_PUBLIC_BASE_URL=
GROUPIA_MEDIA_S3_ENDPOINT=
GROUPIA_MEDIA_S3_REGION=
GROUPIA_MEDIA_S3_BUCKET=
GROUPIA_MEDIA_S3_ACCESS_KEY=
GROUPIA_MEDIA_S3_SECRET_KEY=
GROUPIA_MEDIA_S3_PATH_STYLE_ACCESS=false
GROUPIA_MEDIA_S3_CHUNKED_ENCODING_ENABLED=false
GROUPIA_MEDIA_MAX_UPLOAD_BYTES=8388608
GROUPIA_MEDIA_MAX_WIDTH=6000
GROUPIA_MEDIA_MAX_HEIGHT=6000
GROUPIA_MEDIA_MAX_PIXELS=24000000
GROUPIA_MEDIA_PROCESSING_CONCURRENCY=1
