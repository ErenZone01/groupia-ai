			<dependency><groupId>software.amazon.awssdk</groupId><artifactId>bom</artifactId><version>2.56.0</version><type>pom</type><scope>import</scope></dependency>
			<dependency>
				<groupId>org.springframework.modulith</groupId>
				<artifactId>spring-modulith-bom</artifactId>
				<version>${spring-modulith.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
