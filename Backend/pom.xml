	<dependencies>
		<dependency><groupId>software.amazon.awssdk</groupId><artifactId>s3</artifactId><exclusions><exclusion><groupId>software.amazon.awssdk</groupId><artifactId>apache-client</artifactId></exclusion><exclusion><groupId>software.amazon.awssdk</groupId><artifactId>netty-nio-client</artifactId></exclusion></exclusions></dependency>
